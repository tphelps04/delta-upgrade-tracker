# Copy this file to .env and fill in your real values.
# Never commit the real .env file anywhere.

# --- Trip lookup (Delta "Find Your Trip" — no account login needed) ---
DELTA_CONFIRMATION=GFA2P7
DELTA_FIRST_NAME=Tiffany
DELTA_LAST_NAME=Phelps

# --- Outbound leg ---
OUTBOUND_FLIGHT_NUMBER=DL0979
OUTBOUND_FLIGHT_DATE=2026-08-16
OUTBOUND_THRESHOLD_DELTA_ONE=800
OUTBOUND_THRESHOLD_PREMIUM=500

# --- Return leg ---
RETURN_FLIGHT_NUMBER=DL0752
RETURN_FLIGHT_DATE=2026-08-21
RETURN_THRESHOLD_DELTA_ONE=800
RETURN_THRESHOLD_PREMIUM=500

# --- Alerting (ntfy.sh push notifications — no password needed) ---
# Install the ntfy app (iOS/Android) or use https://ntfy.sh/<topic> in a
# browser, then subscribe to the topic below. Keep the topic name secret —
# anyone who knows it can read your alerts (ntfy.sh topics aren't private
# by default).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=delta-upgrade-1e3ff806137f

# --- Runtime ---
HEADLESS=true
STATE_FILE=state.json
LOG_FILE=logs/price_history.jsonl

# Stop tracking after this time (ISO 8601, with offset). Script self-unloads
# its launchd job once this passes. Should cover through your last leg.
STOP_AT=2026-08-21T09:00:00-07:00
